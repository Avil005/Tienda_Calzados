# Copiar a .env.local y completar (Supabase > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el servidor, nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Cadena aleatoria de 32+ caracteres para firmar la cookie de sesión
SESSION_SECRET=
